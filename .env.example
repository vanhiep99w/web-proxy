# Vercel + Cloudflare: set RELAY_MODE=cloudflare and NEXT_PUBLIC_API_ORIGIN.
# ACCESS_PASSWORD / AUTH_SECRET belong on the Worker, NOT on Vercel in this mode.
NEXT_PUBLIC_API_ORIGIN=

# Standalone/home modes only below. Any non-empty password is accepted.
# A long, random password is recommended for public deployments.
ACCESS_PASSWORD=
# Required. Generate with: openssl rand -hex 32
AUTH_SECRET=

# standalone = all-in-one; frontend = Vercel -> home; home = private backend.
# cloudflare = Vercel UI -> Worker directly; worker = Cloudflare API (wrangler only).
RELAY_MODE=standalone
# Frontend only. Public HTTPS origin; no path/query/credentials.
HOME_BACKEND_URL=
# Required in frontend AND home. The same random key, at least 32 characters.
# Create on the home machine with: npm run setup:home
HOME_BACKEND_KEY=
