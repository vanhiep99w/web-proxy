# Direct Vercel frontend: use RELAY_MODE=vps (Oracle/Node) or cloudflare.
# This is the public HTTPS API origin embedded into the frontend CSP/client.
NEXT_PUBLIC_API_ORIGIN=

# Backend/standalone secrets. Any non-empty password is accepted, but use a long random value.
# Never put either value in NEXT_PUBLIC_* or in Vercel when RELAY_MODE=vps/cloudflare.
ACCESS_PASSWORD=
# Required. Generate with: openssl rand -hex 32
AUTH_SECRET=

# standalone = all-in-one
# vps = Vercel UI -> Oracle/VPS directly; server = Oracle/VPS Node API
# cloudflare = Vercel UI -> Worker directly; worker = Wrangler API
# frontend/home = legacy Vercel proxy -> private home backend pair
RELAY_MODE=standalone

# server only: public API HTTPS origin and exact allowed frontend origins.
# Multiple frontend origins may be comma-separated; no wildcard or path.
API_ORIGIN=
FRONTEND_ORIGINS=

# Legacy frontend/home modes only.
# Frontend only. Public HTTPS origin; no path/query/credentials.
HOME_BACKEND_URL=
# Required in frontend AND home. The same random key, at least 32 characters.
# Create on the home machine with: npm run setup:home
HOME_BACKEND_KEY=
