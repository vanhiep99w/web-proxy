{
  "name": "relay-private-player",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A private, same-origin YouTube player for Vercel. Experimental upstream support.",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "dashjs": "^5.2.1",
    "lucide-react": "^1.49.0",
    "next": "^16.3.8",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "youtubei.js": "^18.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
